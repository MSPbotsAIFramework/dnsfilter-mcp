# Optional overrides — dnsfilter-mcp has no required env vars.
# Authentication is per-request via a header (provided by the MCP caller):
#   X-Dnsfilter-Api-Key   The DNSFilter account's API key (generate at
#                         Account Settings -> Security -> API Keys in the
#                         DNSFilter dashboard). Sent as the raw value of the
#                         Authorization header to DNSFilter's own API — no
#                         Bearer/Basic prefix (see README Authentication).
#
# This server never caches the key and never falls back to an environment
# variable if the header is absent.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
